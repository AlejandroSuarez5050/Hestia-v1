# ============================================================
# HESTIA - EJEMPLO DE VARIABLES DE ENTORNO
# Copia este archivo como .env y rellena los valores.
# ============================================================

# -----------------------------
# Discord (obligatorio)
# -----------------------------
# TOKEN: token del bot en Discord Developer Portal.
TOKEN=tu_token_de_discord

# APP_ID: Application ID del bot (tambien llamado Client ID).
# Se usa para registrar slash commands.
APP_ID=tu_application_id

# GUILD_ID: opcional.
# Si lo defines, npm run commands:register publica comandos solo en ese servidor
# (mas rapido para pruebas). Si lo dejas vacio, publica globalmente.
GUILD_ID=

# -----------------------------
# Lavalink (obligatorio para audio)
# -----------------------------
# Si usas docker-compose de este proyecto, estos valores por defecto funcionan.
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# -----------------------------
# Calidad y comportamiento de reproduccion
# -----------------------------
# DEFAULT_VOLUME: volumen inicial al crear un reproductor (1-150 recomendado).
DEFAULT_VOLUME=80

# DEFAULT_SEARCH_PLATFORM:
# ytmsearch = YouTube Music (recomendado)
# ytsearch  = YouTube
DEFAULT_SEARCH_PLATFORM=ytmsearch

# PLAYLIST_MAX_TRACKS: maximo de pistas que Hestia encola de una playlist.
PLAYLIST_MAX_TRACKS=1000

# AUTOPLAY_DEFAULT: true/false para activar autoplay por defecto.
AUTOPLAY_DEFAULT=false
# AUTOPLAY_BATCH_SIZE: objetivo de canciones en cola cuando autoplay esta activo.
AUTOPLAY_BATCH_SIZE=5
# AUTOPLAY_HISTORY_SIZE: historial para evitar repeticiones en autoplay.
AUTOPLAY_HISTORY_SIZE=50
# AUTOPLAY_MAX_SAME_ARTIST_PER_BATCH: maximo por artista en cada lote autoplay.
AUTOPLAY_MAX_SAME_ARTIST_PER_BATCH=2

# MODO_VERBOSE_UI: true/false para mostrar confirmaciones efimeras en botones (skip, mover, etc).
MODO_VERBOSE_UI=false

# -----------------------------
# Limpieza automatica de reproductor
# -----------------------------
# QUEUE_EMPTY_DESTROY_MS: destruir player cuando la cola queda vacia.
QUEUE_EMPTY_DESTROY_MS=30000

# EMPTY_CHANNEL_DESTROY_MS: destruir player si el canal de voz queda sin usuarios.
EMPTY_CHANNEL_DESTROY_MS=60000

# -----------------------------
# Salud y logs
# -----------------------------
# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL=info

# HEALTH_PORT: puerto interno del endpoint /health para healthcheck docker.
HEALTH_PORT=8080

# -----------------------------
# Spotify (opcional)
# -----------------------------
# Activalo solo si configuraste lavasrc en application.yml y tienes credenciales.
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_FALLBACK_INITIAL_BATCH=25
SPOTIFY_FALLBACK_SEARCH_CONCURRENCY=10

# OAuth usuario para playlists (requiere user-read-private, playlist-read-private y playlist-read-collaborative)
# 1) npm run spotify:auth:url
# 2) autoriza en navegador
# 3) npm run spotify:auth:exchange -- <CODE>
# 4) pega SPOTIFY_REFRESH_TOKEN en .env
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9876/callback
SPOTIFY_REFRESH_TOKEN=
